# ╔══════════════════════════════════════════════════════╗
# ║          NodeSeek 自动签到 配置文件                   ║
# ║  复制此文件为 .env 并填入你的真实信息                    ║
# ╚══════════════════════════════════════════════════════╝

# ── 账号1 ──────────────────────────────────
# NodeSeek 登录用户名和密码
NS_USER1="你的用户名或邮箱"
NS_PASS1="你的密码"
# 接收验证码的邮箱（必须和 NodeSeek 绑定的邮箱一致，QQ/163/Gmail等都行）
IMAP_USER1="你的邮箱"
# 邮箱 IMAP 授权码（不是登录密码！）
# QQ邮箱：设置 → 账户 → POP3/IMAP → 开启 → 生成授权码
# 163邮箱：设置 → POP3/SMTP/IMAP → 开启 → 设置客户端授权密码
# Gmail：开启两步验证 → 应用专用密码
IMAP_PASS1="你的邮箱授权码"

# ── 账号2（没有更多账号就删掉这段）──────────
NS_USER2="第二个用户名"
NS_PASS2="第二个密码"
IMAP_USER2="第二个邮箱"
IMAP_PASS2="第二个邮箱授权码"

# ── 账号3（以此类推，支持无限个）────────────
# NS_USER3="第三个用户名"
# NS_PASS3="第三个密码"
# IMAP_USER3="第三个邮箱"
# IMAP_PASS3="第三个邮箱授权码"

# ── 验证码服务 ──────────────────────────────
# YesCaptcha 的 API Key（用于自动解验证码）
# 注册地址：https://yescaptcha.com
YESCAPTCHA_KEY="你的YesCaptcha客户端Key"
# 国内用户可改为 https://china.yescaptcha.com
YESCAPTCHA_BASE="https://api.yescaptcha.com"

# ── 签到设置 ────────────────────────────────
# 签到模式：true=随机签到（鸡腿多），false=固定签到
NS_RANDOM="true"
